# Only what the gateway image copies; everything else stays out of the build context.
*
!requirements.lock
!packages/
!agents/
!services/
!config/
!policies/
!eval/scenarios/
!eval/reports/*.json
!examples/openai_agent/
!examples/assistant/
examples/assistant/workspace/
!apps/console/
apps/console/node_modules/
apps/console/dist/
apps/console/*.tsbuildinfo
**/__pycache__
**/*.egg-info
**/*.pyc
.env
.env.*
**/.env
