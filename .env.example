# Copy to .env and fill in. Never commit .env. Names only here.

# ---- LLM providers (free tiers). Any number of keys per provider: NAME, NAME_1, NAME_2 ...
# Spare keys are used only if the active key is rejected (401/403), never to multiply rate limits (D-004).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
# Reserved, disabled (PRD §21)
JEV_API_KEY=

# ---- Gateway (required when serving the API/Console; scripts/dev_gateway.py sets dev-only values locally)
# Comma list of name:key:scope, scope = project | admin. Use long random keys.
INTENTSEAL_API_KEYS=
# Read-only key the public Console uses (scope: public)
INTENTSEAL_PUBLIC_KEY=
# Console origin(s) allowed by CORS, comma separated
INTENTSEAL_CORS_ORIGINS=
# Canary values planted in the reference agent's sandbox (comma separated; never real secrets)
INTENTSEAL_CANARIES=

# ---- Optional (uncomment to set; an empty value means the default)
# INTENTSEAL_DB_PATH=                      # SQLite file (default data/intentseal.db)
# INTENTSEAL_RATE_LIMIT_PER_MIN=           # per project/admin key (default 120)
# INTENTSEAL_PUBLIC_RATE_LIMIT_PER_MIN=    # public key (default 20)
# INTENTSEAL_MAX_BODY_BYTES=               # request size limit (default 2 MB)
# INTENTSEAL_STORE_PREVIEWS=               # 0 = store content hashes only, no redacted previews (public demo)
# INTENTSEAL_BUDGET_TIER2_DAILY_TOKENS=    # override the policy's daily judge budget; "none" lifts it (evaluation runs)
# INTENTSEAL_POLICY_DIR=                   # policy directory (default policies/)
# HF_HOME=                          # Hugging Face cache for the local classifier model
