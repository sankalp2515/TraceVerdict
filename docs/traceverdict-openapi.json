  "components": {
    "schemas": {
      "AgentPolicy": {
        "properties": {
          "agent": {
            "type": "string",
            "title": "Agent"
          },
          "org": {
            "type": "string",
            "title": "Org",
            "default": "default"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "monitor"
          },
          "task_scope": {
            "type": "string",
            "title": "Task Scope",
            "default": ""
          },
          "tools": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ToolPolicy"
            },
            "type": "object",
            "title": "Tools"
          },
          "unknown_tools": {
            "type": "string",
            "title": "Unknown Tools",
            "default": "block"
          },
          "sensitive_data": {
            "$ref": "#/components/schemas/SensitiveData"
          },
          "thresholds": {
            "$ref": "#/components/schemas/Thresholds"
          },
          "session": {
            "$ref": "#/components/schemas/SessionPolicy"
          },
          "budgets": {
            "$ref": "#/components/schemas/Budgets"
          },
          "memory": {
            "$ref": "#/components/schemas/MemoryPolicy"
          },
          "taint": {
            "$ref": "#/components/schemas/TaintPolicy"
          },
          "contract": {
            "$ref": "#/components/schemas/ContractPolicy"
          },
          "content_checks": {
            "type": "string",
            "title": "Content Checks",
            "default": "on"
          },
          "upstream": {
            "$ref": "#/components/schemas/UpstreamPolicy"
          },
          "decision_model": {
            "type": "string",
            "title": "Decision Model",
            "default": "generative_free"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "1"
          }
        },
        "type": "object",
        "required": [
          "agent"
        ],
        "title": "AgentPolicy"
      },
      "AgentRegistration": {
        "properties": {
          "agent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
            "title": "Agent Id"
          },
          "policy": {
            "$ref": "#/components/schemas/AgentPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "agent_id",
          "policy"
        ],
        "title": "AgentRegistration"
      },
      "ApprovalRequest": {
        "properties": {
          "base_policy_sha256": {
            "type": "string",
            "title": "Base Policy Sha256"
          },
          "patch_sha256": {
            "type": "string",
            "title": "Patch Sha256"
          },
          "validation_report_sha256": {
            "type": "string",
            "title": "Validation Report Sha256"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "base_policy_sha256",
          "patch_sha256",
          "validation_report_sha256"
        ],
        "title": "ApprovalRequest"
      },
      "Budgets": {
        "properties": {
          "daily_tokens_tier2": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Daily Tokens Tier2"
          },
          "on_exceeded": {
            "type": "string",
            "title": "On Exceeded",
            "default": "rules_only_hold_high_risk"
          }
        },
        "type": "object",
        "title": "Budgets"
      },
      "CandidateRequest": {
        "properties": {
          "operations": {
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Operations"
          },
          "rationale_claim_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
