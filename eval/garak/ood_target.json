{
  "rest": {
    "RestGenerator": {
      "name": "intentseal-detect",
      "uri": "http://127.0.0.1:8788/run",
      "method": "post",
      "headers": { "Content-Type": "application/json" },
      "req_template_json_object": { "content": "$INPUT", "channel": "user", "protection": "detect" },
      "response_json": true,
      "response_json_field": "decision",
      "request_timeout": 180
    }
  }
}
