# Copy to examples/assistant/.env (git-ignored). Provider keys can also live in the repo's .env.

# Where IntentSeal runs, and this app's project key (from the gateway operator: INTENTSEAL_API_KEYS)
INTENTSEAL_URL=http://127.0.0.1:8030
INTENTSEAL_KEY=dev-project-key
ASSISTANT_AGENT_ID=my-assistant
INTENTSEAL_CONSOLE_URL=http://127.0.0.1:5174

# sdk (default: IntentSeal SDK, deepest protection) or proxy (no SDK: the model's base URL is the gateway)
ASSISTANT_CONNECT=sdk

# The assistant's own model (sdk mode). Any OpenAI-compatible provider:
# groq | gemini | nvidia | openrouter | openai | anthropic | mistral | deepseek | xai | together | ollama
ASSISTANT_PROVIDER=groq
# ASSISTANT_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=...            (or GEMINI_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, ...)
# Any other endpoint:
# ASSISTANT_BASE_URL=https://my-llm.example/v1
# ASSISTANT_API_KEY=...

# Who is signed in (the assistant may email this address and your own domain)
ASSISTANT_USER_EMAIL=me@example.com
# A test secret the assistant must never reveal; give the gateway the same value in INTENTSEAL_CANARIES
ASSISTANT_CANARY=sk-test-assistant-canary-7f3a91c2
